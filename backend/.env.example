# Qwen3 4B is a small Ollama chat model; thinking is disabled for faster replies.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:4b

# Small English embedding model (384 dimensions).
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Create this local database and configure its credentials before starting.
DATABASE_URL=postgresql+asyncpg://postgres:change-me@localhost:5432/rag
# Uploaded originals are saved here using generated IDs.
DOCUMENTS_DIR=data/documents
COLLECTION_NAME=rag_minilm_v1
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
